<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="messages-container">
        <ul>
            <% messages.forEach(msg => { %>
                <li> 
                    <p>From: <%= msg.user %></p>
                    <p><%= msg.text %></p>
                    <p>At: <%= msg.added %></p>
                </li>
           <% }) %>
        </ul>
    </div>
    <div class="new">
        <a href="/new">Send a new message</a>
    </div>
</body>
</html>